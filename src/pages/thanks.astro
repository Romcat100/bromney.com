---
import Base from "../layouts/Base.astro";
---

<Base
  title="Thanks · Ben Romney"
  description="Message received."
  noindex
>
  <main id="main" class="thanks">
    <div class="wrap inner">
      <p class="eyebrow">Feedback</p>
      <h1>Got it. Thank&nbsp;you.</h1>
      <p class="lede">Your note is on its way to me.</p>

      <p class="home">
        <a href="/">
          Back to bromney.com<span class="arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </main>
</Base>

<style>
  .thanks {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: clamp(4rem, 10vw, 8rem);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .thanks::before {
    content: "";
    position: absolute;
    inset: -20% -10% auto auto;
    width: 70%;
    height: 80%;
    background: radial-gradient(
      ellipse at 55% 40%,
      color-mix(in srgb, var(--apricot) 28%, transparent) 0%,
      transparent 60%
    );
    z-index: -1;
    pointer-events: none;
  }

  .inner {
    text-align: center;
    max-width: 44rem;
  }

  .eyebrow {
    justify-content: center;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    font-weight: 500;
    color: var(--olive);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: var(--sp-5);
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .eyebrow::before {
    content: "";
    display: block;
    width: 28px;
    height: 1px;
    background: var(--amber);
  }

  h1 {
    font-size: clamp(2.75rem, 1.8rem + 4vw, 4.5rem);
    font-weight: 340;
    font-variation-settings: "opsz" 144, "SOFT" 100;
    letter-spacing: -0.025em;
    line-height: 1;
    margin: 0 0 var(--sp-6);
  }

  .lede {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-style: italic;
    font-weight: 340;
    font-variation-settings: "opsz" 36;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 34ch;
    margin: 0 auto var(--sp-10);
  }

  .home a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--amber);
    border-bottom: 1px solid color-mix(in srgb, var(--amber) 55%, transparent);
    text-decoration: none;
    padding-bottom: 2px;
  }

  .home a:hover {
    color: var(--amber-hover);
    border-bottom-color: var(--amber-hover);
  }

  .home .arrow {
    transition: transform var(--t-base) var(--ease);
  }

  .home a:hover .arrow {
    transform: translateX(3px);
  }
</style>
